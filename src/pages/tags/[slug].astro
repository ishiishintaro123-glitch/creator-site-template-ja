---
import Layout from '../../layouts/Layout.astro';
import MixedWorkList from '../../components/MixedWorkList.astro';
import { t } from '../../site-config.mjs';
import { getTags, hasAllGenreTagPages, tagPath, type Tag } from '../../lib/tags';

// Works of every genre that share a tag, mixed newest first like the all-works list it is opened from.
// Pressing a tag anywhere else opens that genre's list instead (tags/[slug]/[genre].astro).
export async function getStaticPaths() {
	if (!(await hasAllGenreTagPages())) return [];
	return (await getTags()).map((tag) => ({ params: { slug: tag.slug }, props: { tag } }));
}

interface Props {
	tag: Tag;
}

const { tag } = Astro.props;
const title = t.tagPageTitle(tag.name);
---

<Layout title={title} showAuthorLink showGenreNav currentTab="/">
	<div hidden data-list-page={tagPath(tag, 'all')} data-list-back-label={t.backToTag(tag.name)}></div>
	<h1 class="page-title">{title}</h1>
	<MixedWorkList items={tag.items} tagScope="all" />
</Layout>

<style>
	.page-title {
		font-size: 1.4rem;
		margin: 0 0 1.25rem;
		overflow-wrap: anywhere;
	}
</style>
