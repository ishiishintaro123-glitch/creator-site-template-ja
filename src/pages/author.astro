---
import Layout from '../layouts/Layout.astro';
import { siteConfig, t } from '../site-config.mjs';

const links = [
	...(siteConfig.xAccount ? [{ note: '', label: 'X', url: `https://x.com/${siteConfig.xAccount}`, shown: `@${siteConfig.xAccount}` }] : []),
	...siteConfig.links.map((link) => ({ ...link, shown: shownUrl(link.url) })),
];

// The address without https://, www. and a trailing slash: the row's text, so readers see where it goes.
function shownUrl(url: string) {
	const { hostname, pathname, search } = new URL(url);
	return `${hostname.replace(/^www\./, '')}${pathname === '/' ? '' : pathname.replace(/\/$/, '')}${search}`;
}
---

<Layout title={siteConfig.author} description={siteConfig.profile || siteConfig.description} back={{ href: '/', label: t.backToTop }}>
	<h1 class="author-name">{siteConfig.author}</h1>
	{siteConfig.profile && <p class="author-profile">{siteConfig.profile}</p>}
	{links.length > 0 && (
		<ul class="author-links">
			{links.map((link) => (
				<li>
					{link.note && <p class="author-links__note">{link.note}</p>}
					<a href={link.url} target="_blank" rel="noopener noreferrer" class="author-links__row">
						<span class="author-links__url">{link.shown}</span>
						<span class="author-links__mark" aria-hidden="true">↗</span>
					</a>
				</li>
			))}
		</ul>
	)}
</Layout>

<style>
	.author-name {
		font-size: 1.5rem;
		margin: 0 0 1rem;
		overflow-wrap: anywhere;
	}

	.author-profile {
		margin: 0;
		line-height: 1.8;
		white-space: pre-line;
		overflow-wrap: anywhere;
	}

	.author-links {
		list-style: none;
		margin: 1.75rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	/* Same text style as the profile. */
	.author-links__note {
		margin: 0 0 0.4rem;
		line-height: 1.8;
		white-space: pre-line;
		overflow-wrap: anywhere;
	}

	/* Same look as a table of contents row. */
	.author-links__row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid var(--border);
		border-radius: 0.4rem;
		padding: 0.6rem 0.9rem;
		color: var(--accent);
	}

	.author-links__row:hover {
		text-decoration: none;
		border-color: var(--accent);
	}

	.author-links__url {
		min-width: 0;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.author-links__mark {
		flex-shrink: 0;
		color: var(--text-muted);
	}
</style>
