---
import Layout from '../layouts/Layout.astro';
import { t } from '../site-config.mjs';
---

<Layout title={t.notFoundTitle} back={{ href: '/', label: t.backToTop }}>
	<h1 class="not-found-title">{t.notFoundTitle}</h1>
	<p class="not-found-text">{t.notFoundText}</p>
</Layout>

<style>
	.not-found-title {
		font-size: 1.5rem;
		margin: 0 0 1rem;
	}

	.not-found-text {
		margin: 0;
		color: var(--text-muted);
	}
</style>
