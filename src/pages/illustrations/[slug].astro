---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ImageViewer from '../../components/ImageViewer.astro';
import TagList from '../../components/TagList.astro';
import { tagListPaths } from '../../lib/tags';
import { formatDate } from '../../lib/format-date';
import { siteConfig, t } from '../../site-config.mjs';
import { getIllustrations, type Illustration } from '../../lib/illustrations';

export async function getStaticPaths() {
	const illustrations = await getIllustrations();
	return illustrations.map((illustration) => ({ params: { slug: illustration.slug }, props: { illustration } }));
}

const { illustration } = Astro.props as { illustration: Illustration };
const alt = illustration.title || illustration.description || t.illustrationAlt;

// Each image, pressed, opens whole and large (ImageViewer), using the same files as the page.
const imageOptions = (image: ImageMetadata) => ({ widths: [480, 800, 1200, 1600], width: Math.min(1600, image.width) });
const large = await Promise.all(illustration.images.map((image) => getImage({ src: image, ...imageOptions(image) })));

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
// X's link card shows only the first image, so say how many there are.
const count = illustration.images.length;
const shareText = count > 1 ? `${illustration.label}${t.shareImageCount(count)}` : illustration.label;
const shareParams = new URLSearchParams({ text: shareText, url: pageUrl });
if (siteConfig.xAccount) shareParams.set('via', siteConfig.xAccount);
const shareHref = `https://twitter.com/intent/tweet?${shareParams}`;
---

<Layout
	title={illustration.label}
	description={illustration.description || undefined}
	wide
	image={illustration.images[0]}
	back={{ href: '/illustrations', label: t.backToIllustrationList, toList: true, tagLists: await tagListPaths(illustration.tags, 'illustrations') }}
>
	<div class="images">
		{illustration.images.map((image, index) => (
			<button
				type="button"
				class="images__open"
				aria-label={t.imageOpen}
				data-viewer-open
				data-src={large[index].src}
				data-srcset={large[index].srcSet.attribute}
				data-alt={alt}
			>
				<Image src={image} alt={alt} {...imageOptions(image)} sizes="(min-width: 60rem) 60rem, 100vw" loading={index === 0 ? 'eager' : 'lazy'} />
			</button>
		))}
	</div>

	<div class="info">
		{illustration.title && <h1 class="info__title">{illustration.title}</h1>}
		<p class="info__date">{formatDate(illustration.publishedAt)}</p>
		{illustration.description && <p class="info__description">{illustration.description}</p>}
		{illustration.tags.length > 0 && (
			<div class="info__tags">
				<TagList tags={illustration.tags} scope="illustrations" />
			</div>
		)}
	</div>

	<ImageViewer />

	<a class="share-button" href={shareHref} target="_blank" rel="noopener noreferrer">
		{t.shareOnX}
	</a>

	{/* The ad comes last, as on a chapter page, so sharing comes first. */}
	{siteConfig.ads?.afterEpisode && (
		<div class="illustration-ad">
			<AdSlot code={siteConfig.ads.afterEpisode} />
		</div>
	)}
</Layout>

<style>
	.images {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.images__open {
		display: block;
		max-width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	.images img {
		display: block;
		max-width: 100%;
		height: auto;
		/* Keep the whole picture on screen instead of cropping tall images. */
		max-height: 90vh;
		object-fit: contain;
	}

	.info {
		max-width: 42rem;
		margin: 1.5rem auto 0;
	}

	.info__title {
		font-size: 1.3rem;
		margin: 0 0 0.3rem;
	}

	.info__date {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.info__description {
		margin: 1rem 0 0;
		line-height: 1.8;
		white-space: pre-line;
		overflow-wrap: anywhere;
	}

	.info__tags {
		margin-top: 1rem;
	}

	/* Generous spacing keeps the ad visually separate from the button above (ad networks prohibit placements that invite accidental clicks). */
	.illustration-ad {
		max-width: 42rem;
		margin: 3rem auto 0;
	}

	.share-button {
		display: block;
		width: fit-content;
		margin: 1.5rem auto 0;
		padding: 0.65rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
	}

	.share-button:hover {
		text-decoration: none;
		border-color: var(--accent);
	}
</style>
