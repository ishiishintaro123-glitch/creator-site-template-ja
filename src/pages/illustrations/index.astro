---
import Layout from '../../layouts/Layout.astro';
import { getGenres } from '../../lib/catalog';
import IllustrationFeedItem from '../../components/IllustrationFeedItem.astro';
import IllustrationTile from '../../components/IllustrationTile.astro';
import { siteConfig, t } from '../../site-config.mjs';
import { getIllustrations } from '../../lib/illustrations';
import { redirectTo } from '../../lib/redirect';

const illustrations = await getIllustrations();
// No illustrations on this site: send visitors to the top page instead of an empty list.
if (illustrations.length === 0) return redirectTo('/');
// The only genre's list is the top page: it goes by the site name alone, in the tab and on share cards.
const genres = await getGenres();
---

<Layout title={genres.length < 2 ? '' : t.illustrationListTitle} description={siteConfig.description} showAuthorLink showGenreNav wide>
	<div hidden data-list-page="/illustrations"></div>
	<div class="list-header">
		<h1 class="page-title">{t.navIllustrations}</h1>
		<div class="view-switch" role="group" aria-label={t.illustrationViewLabel}>
			<button type="button" data-illustration-view-option="feed">{t.viewFeed}</button>
			<button type="button" data-illustration-view-option="grid">{t.viewGrid}</button>
		</div>
	</div>

	{/* Both views are in the page; the reader's choice (html[data-illustration-view], set by settings.js) shows one.
	    The feed comes first so new work is seen right away; the grid is for looking through older work. */}
	<ul class="feed">
		{illustrations.map((illustration, index) => <IllustrationFeedItem illustration={illustration} eager={index < 2} />)}
	</ul>
	<ul class="gallery">
		{illustrations.map((illustration) => <IllustrationTile illustration={illustration} />)}
	</ul>
</Layout>

<style>
	.list-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.page-title {
		font-size: 1.4rem;
		margin: 0;
	}

	/* Same look as the genre tabs in the header: the current view is plain text with an orange underline,
	   the other one is orange because it can be pressed. */
	.view-switch {
		display: flex;
		gap: 1.25rem;
	}

	.view-switch button {
		font: inherit;
		font-weight: 600;
		white-space: nowrap;
		color: var(--accent);
		background: none;
		border: none;
		border-bottom: 2px solid transparent;
		padding: 0 0 0.2rem;
		cursor: pointer;
	}

	.view-switch button[aria-pressed='true'] {
		color: var(--text);
		border-bottom-color: var(--accent);
		cursor: default;
	}

	.view-switch button[aria-pressed='false']:hover {
		border-bottom-color: var(--accent);
	}

	.feed,
	.gallery {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.feed {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.gallery {
		display: none;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 1rem;
	}

	:global(html[data-illustration-view='grid']) .feed {
		display: none;
	}

	:global(html[data-illustration-view='grid']) .gallery {
		display: grid;
	}
</style>
