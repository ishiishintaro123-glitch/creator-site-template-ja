---
import AdSlot from './AdSlot.astro';
import IllustrationCard from './IllustrationCard.astro';
import WorkCard from './WorkCard.astro';
import { siteConfig, t } from '../site-config.mjs';
import type { ListItem } from '../lib/catalog';
import type { TagScope } from '../lib/tags';

// Works in one list (the all-works list and tag pages), each labeled with its genre when the list mixes genres.
interface Props {
	items: ListItem[];
	/** Off where the genre is already clear (a genre's tag list). */
	genreLabels?: boolean;
	/** Which tag lists the works' tags open: 'all' where genres are mixed, else the list's genre. */
	tagScope: TagScope;
}

const { items, genreLabels = true, tagScope } = Astro.props;
const label = (text: string) => (genreLabels ? text : undefined);

const LIST_FEED_INTERVAL = 5;
---

<ul class="work-list">
	{
		items.map((item, index) => (
			<Fragment>
				{item.kind === 'novel' && (
					<WorkCard work={item.work} basePath="/novels" cover={item.work.cover} genreLabel={label(t.navNovels)} tagScope={tagScope} />
				)}
				{item.kind === 'manga' && (
					<WorkCard work={item.work} basePath="/manga" cover={item.work.cover} genreLabel={label(t.navManga)} tagScope={tagScope} />
				)}
				{item.kind === 'illustration' && (
					<IllustrationCard illustration={item.illustration} genreLabel={label(t.navIllustrations)} tagScope={tagScope} />
				)}
				{/* An ad after every 5th work, but never after the last one. */}
				{siteConfig.ads?.listFeed && (index + 1) % LIST_FEED_INTERVAL === 0 && index < items.length - 1 && (
					<li class="work-list__ad">
						<AdSlot code={siteConfig.ads.listFeed} />
					</li>
				)}
			</Fragment>
		))
	}
</ul>

<style>
	.work-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.work-list__ad {
		padding: 0.5rem 0;
	}
</style>
