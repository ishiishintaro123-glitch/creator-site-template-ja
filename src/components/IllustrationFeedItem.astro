---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TagList from './TagList.astro';
import { t } from '../site-config.mjs';
import type { Illustration } from '../lib/illustrations';

// One illustration in the scrolling feed: the title and tags, then every image large, one under another. The feed is
// for looking at the work, so a multi-image post is seen whole without opening it; the grid is for finding a post.
// An image, pressed, opens alone and large (ImageViewer, placed once by the list page); the title opens the post.
interface Props {
	illustration: Illustration;
	/** Load the first image right away (for the first few posts); the rest load as the reader scrolls. */
	eager?: boolean;
}

const { illustration, eager = false } = Astro.props;
const alt = illustration.title || illustration.description || t.illustrationAlt;
const imageOptions = (image: ImageMetadata) => ({ widths: [480, 800, 1200, 1600], width: Math.min(1600, image.width) });
const large = await Promise.all(illustration.images.map((image) => getImage({ src: image, ...imageOptions(image) })));
---

<li class="feed-item">
	{/* As wide as the picture, centered; the title and tags above line up with its left edge. */}
	<div class="feed-item__body">
		{/* Untitled posts get their label (date), so every post can be opened from here. */}
		<a href={`/illustrations/${illustration.slug}`} class="feed-item__title">
			{illustration.label}
		</a>
		{/* Not inside a link: a tag is a link of its own. */}
		{illustration.tags.length > 0 && (
			<div class="feed-item__tags">
				<TagList tags={illustration.tags} scope="illustrations" />
			</div>
		)}
		<div class="feed-item__images">
			{illustration.images.map((image, index) => (
				<button
					type="button"
					class="feed-item__open"
					aria-label={t.imageOpen}
					data-viewer-open
					data-src={large[index].src}
					data-srcset={large[index].srcSet.attribute}
					data-alt={alt}
				>
					<Image
						src={image}
						alt={alt}
						{...imageOptions(image)}
						sizes="(min-width: 60rem) 60rem, 100vw"
						loading={eager && index === 0 ? 'eager' : 'lazy'}
						class="feed-item__image"
					/>
				</button>
			))}
		</div>
	</div>
</li>

<style>
	.feed-item {
		display: flex;
		justify-content: center;
	}

	.feed-item__body {
		min-width: 0;
		max-width: 100%;
	}

	.feed-item__open {
		display: block;
		max-width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	.feed-item__images {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	/* Natural size up to the page width, and never taller than the screen, so each picture is seen whole. */
	.feed-item__image {
		display: block;
		max-width: 100%;
		max-height: 90vh;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 0.4rem;
	}

	/* width: 0 keeps text from widening the column past the picture; min-width: 100% then fills it. */
	.feed-item__title,
	.feed-item__tags {
		width: 0;
		min-width: 100%;
	}

	.feed-item__title {
		display: block;
		color: var(--accent);
		margin-bottom: 0.6rem;
		font-weight: 700;
		overflow-wrap: anywhere;
	}

	.feed-item__tags {
		margin-bottom: 0.6rem;
	}

	.feed-item__title:hover {
		text-decoration: underline;
	}
</style>
