---
import { Image } from 'astro:assets';
import { t } from '../site-config.mjs';
import type { Illustration } from '../lib/illustrations';

// An illustration in the all-works list, laid out like the novel and manga cards.
interface Props {
	illustration: Illustration;
	genreLabel: string;
}

const { illustration, genreLabel } = Astro.props;
const href = `/illustrations/${illustration.slug}`;
const imageCount = illustration.images.length;
---

<li class="card">
	<a href={href} class="card__image-link" tabindex="-1" aria-hidden="true">
		<Image src={illustration.images[0]} alt="" widths={[160, 320]} sizes="160px" class="card__image" />
		{imageCount > 1 && <span class="card__count">{t.imageCount(imageCount)}</span>}
	</a>
	<div>
		<p class="card__genre">{genreLabel}</p>
		<a href={href} class="card__title">{illustration.label}</a>
	</div>
</li>

<style>
	.card {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		column-gap: 1rem;
		align-items: start;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: var(--bg-elevated);
		padding: 1rem 1.1rem;
	}

	.card__image-link {
		position: relative;
		display: block;
	}

	/* Same badge as the gallery tiles. */
	.card__count {
		position: absolute;
		top: 0.3rem;
		right: 0.3rem;
		font-size: 0.7rem;
		font-weight: 600;
		color: #fff;
		background: rgba(0, 0, 0, 0.6);
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
	}

	.card__image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 0.3rem;
	}

	.card__genre {
		margin: 0 0 0.3rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	/* Same divider under the title as the novel and manga cards. */
	.card__title {
		display: block;
		font-size: 1.05rem;
		font-weight: 700;
		overflow-wrap: anywhere;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--border);
	}
</style>
