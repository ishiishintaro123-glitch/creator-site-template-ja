---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import CompletedBadge from './CompletedBadge.astro';
import TagList from './TagList.astro';
import { t } from '../site-config.mjs';
import type { TagScope } from '../lib/tags';

// A novel or manga in a list. A cover image, when given, appears to the left of the text.
interface Props {
	work: {
		slug: string;
		title: string;
		synopsis: string;
		tags: string[];
		completed: boolean;
		episodes: { id: string }[];
	};
	basePath: '/novels' | '/manga';
	cover?: ImageMetadata;
	/** Genre name shown above the title in the all-works list. */
	genreLabel?: string;
	/** 'all' in lists of every genre; otherwise the tags open this genre's tag lists. */
	tagScope?: TagScope;
}

const { work, basePath, cover, genreLabel } = Astro.props;
const tagScope = Astro.props.tagScope ?? (basePath === '/novels' ? 'novels' : 'manga');
// Reading history is stored per work; manga get their own key so a novel and a manga with the same ID don't mix.
const historyKey = basePath === '/novels' ? work.slug : `manga/${work.slug}`;
const firstHref = `${basePath}/${work.episodes[0].id}`;
const titleHref = work.episodes.length > 1 ? `${basePath}/${work.slug}` : firstHref;
---

<li
	class:list={['novel-card', { 'novel-card--with-cover': cover }]}
	data-work-slug={historyKey}
	data-episode-count={work.episodes.length}
	data-base-href={`${basePath}/${work.slug}`}
>
	{cover && (
		<a href={titleHref} class="novel-card__cover" tabindex="-1" aria-hidden="true">
			<Image src={cover} alt="" widths={[160, 320]} width={Math.min(320, cover.width)} sizes="160px" />
		</a>
	)}
	<div class="novel-card__body">
		{genreLabel && <p class="novel-card__genre">{genreLabel}</p>}
		<a href={titleHref} class="novel-card__title">
			<span class="novel-card__title-text">{work.title}</span>
			<span class="novel-card__episode">
				{t.totalEpisodes(work.episodes.length)}
			</span>
			{work.completed && <CompletedBadge />}
			{/* Filled in by public/history.js: episodes added since the reader last read this work. */}
			<span class="novel-card__new" data-new-badge data-label={t.newEpisodesTemplate} hidden></span>
		</a>
		{work.synopsis && <p class="novel-card__synopsis" data-synopsis>{work.synopsis}</p>}
		<button
			type="button"
			class="novel-card__synopsis-toggle"
			data-synopsis-toggle
			data-label-expand={t.showMore}
			data-label-collapse={t.showLess}
			hidden
		>
			{t.showMore}
		</button>
		{work.tags.length > 0 && (
			<div class="novel-card__tags">
				<TagList tags={work.tags} scope={tagScope} />
			</div>
		)}
	</div>
	<a
		class="novel-card__link"
		data-continue-link
		data-label-continue={t.continueReadingTemplate}
		data-label-read-again={t.readAgainTemplate}
		href={firstHref}
	>
		{t.startReading}
	</a>
</li>

<style>
	.novel-card {
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: var(--bg-elevated);
		padding: 1rem 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	/* With a cover: the cover floats on the left and the text runs beside it. The title and synopsis keep to their
	   column (flex and line-clamp boxes don't wrap under a float), while tags that start below the cover use the
	   full width instead of leaving a gap under it. */
	.novel-card--with-cover {
		display: flow-root;
	}

	.novel-card__cover {
		float: left;
		width: 6.5rem;
		margin: 0 1rem 0.5rem 0;
	}

	.novel-card--with-cover .novel-card__link {
		clear: both;
		display: block;
		width: fit-content;
		margin: 0.75rem 0 0 auto;
		white-space: nowrap;
	}

	.novel-card__cover img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 0.3rem;
	}

	.novel-card__genre {
		margin: 0 0 0.3rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	.novel-card__title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent);
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--border);
	}

	.novel-card__title:hover {
		text-decoration: none;
	}

	.novel-card__title:hover .novel-card__title-text {
		text-decoration: underline;
	}

	.novel-card__episode {
		flex-shrink: 0;
		white-space: nowrap;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	.novel-card__new {
		flex-shrink: 0;
		white-space: nowrap;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--bg);
		background: var(--accent);
		border-radius: 0.25rem;
		padding: 0 0.4rem;
	}

	.novel-card__new[hidden] {
		display: none;
	}

	.novel-card__synopsis {
		margin: 0.6rem 0 0;
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.novel-card__synopsis[data-truncatable] {
		cursor: pointer;
	}

	.novel-card__synopsis--expanded {
		display: block;
		-webkit-line-clamp: unset;
		overflow: visible;
	}

	.novel-card__synopsis-toggle {
		display: block;
		margin-top: -0.3rem;
		margin-left: auto;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.novel-card__synopsis-toggle[hidden] {
		display: none;
	}

	.novel-card__synopsis-toggle:hover {
		text-decoration: underline;
	}

	.novel-card__tags {
		margin-top: 0.6rem;
	}

	.novel-card__link {
		align-self: flex-end;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.45rem 1.1rem;
	}

	.novel-card__link:hover {
		text-decoration: none;
		border-color: var(--accent);
	}
</style>
