---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t } from '../site-config.mjs';

// A novel or manga in a list. A cover image, when given, appears to the left of the text.
interface Props {
	work: {
		slug: string;
		title: string;
		synopsis: string;
		tags: string[];
		episodes: { id: string }[];
	};
	basePath: '/novels' | '/manga';
	cover?: ImageMetadata;
	/** Genre name shown above the title in the all-works list. */
	genreLabel?: string;
}

const { work, basePath, cover, genreLabel } = Astro.props;
// Reading history is stored per work; manga get their own key so a novel and a manga with the same ID don't mix.
const historyKey = basePath === '/novels' ? work.slug : `manga/${work.slug}`;
const firstHref = `${basePath}/${work.episodes[0].id}`;
const titleHref = work.episodes.length > 1 ? `${basePath}/${work.slug}` : firstHref;
---

<li
	class:list={['novel-card', { 'novel-card--with-cover': cover }]}
	data-work-slug={historyKey}
	data-episode-count={work.episodes.length}
	data-base-href={`${basePath}/${work.slug}`}
>
	{cover && (
		<a href={titleHref} class="novel-card__cover" tabindex="-1" aria-hidden="true">
			<Image src={cover} alt="" widths={[160, 320]} sizes="160px" />
		</a>
	)}
	<div class="novel-card__body">
		{genreLabel && <p class="novel-card__genre">{genreLabel}</p>}
		<a href={titleHref} class="novel-card__title">
			<span class="novel-card__title-text">{work.title}</span>
			<span class="novel-card__episode">
				{t.totalEpisodes(work.episodes.length)}
			</span>
		</a>
		{work.synopsis && <p class="novel-card__synopsis" data-synopsis>{work.synopsis}</p>}
		<button
			type="button"
			class="novel-card__synopsis-toggle"
			data-synopsis-toggle
			data-label-expand={t.showMore}
			data-label-collapse={t.showLess}
			hidden
		>
			{t.showMore}
		</button>
		{work.tags.length > 0 && (
			<ul class="novel-card__tags">
				{work.tags.map((tag) => (
					<li>{tag}</li>
				))}
			</ul>
		)}
	</div>
	<a
		class="novel-card__link"
		data-continue-link
		data-label-continue={t.continueReadingTemplate}
		data-label-read-again={t.readAgainTemplate}
		href={firstHref}
	>
		{t.startReading}
	</a>
</li>

<style>
	.novel-card {
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		background: var(--bg-elevated);
		padding: 1rem 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	/* With a cover: cover on the left, text and button on the right. */
	.novel-card--with-cover {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		column-gap: 1rem;
	}

	.novel-card--with-cover .novel-card__link {
		grid-column: 1 / -1;
		justify-self: end;
		white-space: nowrap;
	}

	.novel-card__cover {
		align-self: start;
	}

	.novel-card__cover img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 0.3rem;
	}

	.novel-card__genre {
		margin: 0 0 0.3rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	.novel-card__title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent);
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--border);
	}

	.novel-card__title:hover {
		text-decoration: none;
	}

	.novel-card__title:hover .novel-card__title-text {
		text-decoration: underline;
	}

	.novel-card__episode {
		flex-shrink: 0;
		white-space: nowrap;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	.novel-card__synopsis {
		margin: 0.6rem 0 0;
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.novel-card__synopsis[data-truncatable] {
		cursor: pointer;
	}

	.novel-card__synopsis--expanded {
		display: block;
		-webkit-line-clamp: unset;
		overflow: visible;
	}

	.novel-card__synopsis-toggle {
		display: block;
		margin-top: -0.3rem;
		margin-left: auto;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.novel-card__synopsis-toggle[hidden] {
		display: none;
	}

	.novel-card__synopsis-toggle:hover {
		text-decoration: underline;
	}

	.novel-card__tags {
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.novel-card__tags li {
		font-size: 0.75rem;
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.15rem 0.6rem;
	}

	.novel-card__link {
		align-self: flex-end;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.45rem 1.1rem;
	}

	.novel-card__link:hover {
		text-decoration: none;
		border-color: var(--accent);
	}
</style>
