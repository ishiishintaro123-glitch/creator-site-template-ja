---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import AdSlot from './AdSlot.astro';
import CompletedBadge from './CompletedBadge.astro';
import ImageViewer from './ImageViewer.astro';
import TagList from './TagList.astro';
import { tagListPaths } from '../lib/tags';
import { formatDate } from '../lib/format-date';
import { siteConfig, t } from '../site-config.mjs';

// A work's page with its table of contents; shared by novels and manga.
interface Props {
	work: {
		slug: string;
		title: string;
		synopsis: string;
		tags: string[];
		completed: boolean;
		episodes: { id: string; number: number; title: string; publishedAt: Date }[];
		chapters?: { title: string; start: number }[];
	};
	basePath: '/novels' | '/manga';
	historyKey: string;
	backHref: string;
	backLabel: string;
	cover?: ImageMetadata;
}

const { work, basePath, historyKey, backHref, backLabel, cover } = Astro.props;
const { slug, episodes } = work;
const tagLists = await tagListPaths(work.tags, basePath === '/novels' ? 'novels' : 'manga');
// The cover shown whole and large when tapped (ImageViewer). Same widths as a manga page, so a manga whose
// cover is its first page reuses those files.
const fullCover = cover && (await getImage({ src: cover, widths: [480, 800, 1200], width: Math.min(1200, cover.width) }));

// The contents are split at chapter headings (novels; see src/lib/novels.ts), or every 100 episodes when a long work
// has none. The sections start closed so the headings give an overview (the buttons above start or continue reading);
// public/history.js opens the one the reader is in. A lone section stays open.
const SECTION_SIZE = 100;
const chapters = work.chapters ?? [];
const starts =
	chapters.length > 0
		? [...(chapters[0].start > 1 ? [{ title: '', start: 1 }] : []), ...chapters]
		: Array.from({ length: Math.ceil(episodes.length / SECTION_SIZE) }, (_, i) => ({ title: '', start: i * SECTION_SIZE + 1 }));
const sections = starts.map((section, i) => ({
	title: section.title,
	episodes: episodes.slice(section.start - 1, (starts[i + 1]?.start ?? episodes.length + 1) - 1),
}));
const plain = sections.length < 2 && !sections[0]?.title;
const Section = plain ? 'div' : 'details';
---

<Layout title={work.title} description={work.synopsis || undefined} image={cover} back={{ href: backHref, label: backLabel, toList: true, tagLists }}>
	<header class="work-header">
		{cover && fullCover && (
			<button
				type="button"
				class="work-header__cover"
				aria-label={t.coverOpen}
				data-viewer-open
				data-src={fullCover.src}
				data-srcset={fullCover.srcSet.attribute}
				data-alt={t.coverAlt(work.title)}
			>
				<Image src={cover} alt="" widths={[240, 480]} width={Math.min(480, cover.width)} sizes="240px" />
			</button>
		)}
		<h1 class="work-header__title">{work.title}</h1>
		{work.completed && (
			<p class="work-header__status">
				<CompletedBadge />
			</p>
		)}
		{work.synopsis && <p class="work-header__synopsis">{work.synopsis}</p>}
		{work.tags.length > 0 && (
			<div class="work-header__tags">
				<TagList tags={work.tags} scope={basePath === '/novels' ? 'novels' : 'manga'} />
			</div>
		)}
	</header>

	<div class="continue-row" data-work-slug={historyKey} data-episode-count={episodes.length} data-base-href={`${basePath}/${slug}`}>
		<a
			class="primary-link"
			data-continue-link
			data-label-continue={t.continueReadingTemplate}
			data-label-read-again={t.readAgainTemplate}
			href={`${basePath}/${episodes[0].id}`}
		>
			{t.startReading}
		</a>
	</div>

	<h2 class="toc-heading">{t.toc}</h2>
	<div class="toc-sections" data-toc-work={plain ? undefined : historyKey}>
		{sections.map((section, i) => {
			const first = section.episodes[0].number;
			const last = section.episodes[section.episodes.length - 1].number;
			return (
				<Section
					class="toc-section"
					open={plain ? undefined : sections.length === 1}
					data-toc-section-first={first}
					data-toc-section-last={last}
				>
					{!plain && (
						<summary class="toc-section__summary">
							{section.title && <span class="toc-section__title">{section.title}</span>}
							<span class={section.title ? 'toc-section__range' : 'toc-section__title'}>{t.tocRange(first, last)}</span>
						</summary>
					)}
					<ol class="episode-list">
						{section.episodes.map((episode) => (
							<li>
								<a
									class="episode-list__row"
									href={`${basePath}/${episode.id}`}
									data-work-slug={historyKey}
									data-toc-episode={episode.number}
								>
									<span class="episode-list__label">
										{t.episodeNumber(episode.number)}{episode.title && <span class="episode-list__title">{episode.title}</span>}
									</span>
									{/* Shown by public/history.js on episodes added since the reader last read this work. */}
									<span class="episode-list__new" data-new-mark hidden>{t.newEpisode}</span>
									<span class="episode-list__date">{formatDate(episode.publishedAt)}</span>
								</a>
							</li>
						))}
					</ol>
				</Section>
			);
		})}
	</div>

	{cover && <ImageViewer />}

	{siteConfig.ads?.workToc && (
		<div class="toc-ad">
			<AdSlot code={siteConfig.ads.workToc} />
		</div>
	)}
</Layout>

<style>
	/* The cover centered at a good size on top, then the title and synopsis across the full width below it. */
	.work-header__cover {
		width: 12rem;
		max-width: 100%;
		margin: 0 auto 1rem;
		display: block;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	.work-header__cover img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 0.3rem;
	}

	.work-header__title {
		font-size: 1.5rem;
		margin: 0 0 0.6rem;
	}

	.work-header__status {
		margin: 0 0 0.6rem;
	}

	.work-header__synopsis {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.7;
	}

	.work-header__tags {
		margin-top: 0.75rem;
	}

	.continue-row {
		display: flex;
		justify-content: flex-end;
	}

	.primary-link {
		display: inline-block;
		margin-top: 0.75rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.55rem 1.3rem;
	}

	.primary-link:hover {
		text-decoration: none;
		border-color: var(--accent);
	}

	.toc-heading {
		margin: 2.5rem 0 0.75rem;
		font-size: 1.05rem;
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
	}

	.toc-sections {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.toc-section__summary {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		position: relative;
		padding: 0.6rem 2.4rem 0.6rem 0.9rem;
		border: 1px solid var(--border);
		border-radius: 0.4rem;
		background: var(--bg-elevated);
		cursor: pointer;
		font-weight: 600;
		list-style: none;
	}

	.toc-section__summary:hover {
		border-color: var(--accent);
	}

	/* Our own marker, so it reads as something to tap in every browser. Kept at the right edge, centered even when the title wraps. */
	.toc-section__summary::before {
		content: '＋';
		color: var(--accent);
		position: absolute;
		right: 0.9rem;
		top: 50%;
		transform: translateY(-50%);
	}

	details[open] > .toc-section__summary {
		margin-bottom: 0.4rem;
	}

	details[open] > .toc-section__summary::before {
		content: '－';
	}

	.toc-section__summary::-webkit-details-marker {
		display: none;
	}

	.toc-section__title {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.toc-section__range {
		font-size: 0.8rem;
		font-weight: normal;
		color: var(--text-muted);
	}

	details.toc-section > .episode-list {
		margin-bottom: 0.5rem;
	}

	.episode-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.episode-list__row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		border: 1px solid var(--border);
		border-radius: 0.4rem;
		padding: 0.6rem 0.9rem;
		color: var(--accent);
	}

	.episode-list__row:hover {
		text-decoration: none;
		border-color: var(--accent);
	}

	.episode-list__row.is-read {
		color: var(--text-muted);
		opacity: 0.6;
	}

	.episode-list__label {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.episode-list__title {
		margin-left: 0.75em;
	}

	.episode-list__new {
		flex-shrink: 0;
		margin-left: auto;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--bg);
		background: var(--accent);
		border-radius: 0.25rem;
		padding: 0 0.4rem;
	}

	.episode-list__new[hidden] {
		display: none;
	}

	.episode-list__new + .episode-list__date {
		margin-left: 0.6rem;
	}

	.episode-list__date {
		flex-shrink: 0;
		margin-left: 1rem;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.toc-ad {
		margin-top: 2.5rem;
	}
</style>
