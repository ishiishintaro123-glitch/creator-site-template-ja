---
import { t } from '../site-config.mjs';

interface Props {
	code: string | undefined;
}

const { code } = Astro.props;
---

{code && (
	<aside class="ad" aria-label={t.ad}>
		<p class="ad__label">{t.ad}</p>
		{/* The creator's own ad code from site.config.yaml, rendered as-is so any ad network's snippet works. */}
		<div class="ad__slot" set:html={code} />
	</aside>
)}

<style>
	.ad__label {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		color: var(--text-muted);
		text-align: center;
	}

	.ad__slot {
		text-align: center;
		overflow: hidden;
	}
</style>
